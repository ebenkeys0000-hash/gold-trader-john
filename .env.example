# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# ==============================================================================
# SERVER-SIDE CONFIGURATION VARIABLES (NEVER EXPOSED TO CLIENT JAVASCRIPT)
# ==============================================================================
# The public website runs completely independently without any of these variables.

# ADMIN_SECRET_KEY (Required ONLY for /admin sign in):
# The administrative passcode for logging into the server-side CMS dashboard.
# No hardcoded password or fallback secret exists in source code.
# If unset, the /admin login displays a clear configuration notice.
ADMIN_SECRET_KEY=""

# GOOGLE_APPS_SCRIPT_URL (Optional):
# The Google Apps Script Web App execution URL to synchronize CMS content & applications to Google Sheets.
# Example: https://script.google.com/macros/s/.../exec
GOOGLE_APPS_SCRIPT_URL=""

# APPS_SCRIPT_SECRET (Optional):
# The shared authorization secret token passed by the server to Google Apps Script.
# Kept strictly server-side; never exposed to browser client code.
APPS_SCRIPT_SECRET=""
